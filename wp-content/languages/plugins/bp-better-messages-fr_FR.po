msgctxt "Settings page"
msgid "Callback URL is reachable"
msgstr "L'URL de rappel est accessible"

#: inc/translations/strings.php:1427
msgctxt "Settings page"
msgid "Callback URL is reachable. Cloud AI features will work at full speed."
msgstr "L'URL de rappel est accessible. Les fonctionnalités Cloud AI fonctionneront à pleine vitesse."

