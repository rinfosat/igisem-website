msgctxt "AI Chat Bots (WP Admin)"
msgid "Points per $1 of API cost"
msgstr "Points par 1 $ de coût API"

#: inc/translations/strings.php:915
msgctxt "AI Chat Bots (WP Admin)"
msgid "Fixed number of points charged each time the bot responds. Users must have at least this many points to send a message."
msgstr "Nombre fixe de points facturés à chaque réponse du bot. Les utilisateurs doivent avoir au moins ce nombre de points pour envoyer un message."

