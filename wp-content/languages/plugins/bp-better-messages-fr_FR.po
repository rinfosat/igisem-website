msgctxt "AI Chat Bots (WP Admin)"
msgid "Charge for Group Mentions"
msgstr "Facturer les mentions de groupe"

#: inc/translations/strings.php:924
msgctxt "AI Chat Bots (WP Admin)"
msgid "Insufficient points balance to use this bot"
msgstr "Solde de points insuffisant pour utiliser ce bot"

